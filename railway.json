{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT app:app --timeout 120 --workers 1 --max-requests 1000 --max-requests-jitter 100",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "healthcheckInterval": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  },
  "environments": {
    "production": {
      "variables": {
        "RILEY_ENV": "production",
        "RILEY_DOMAIN": "riley-genesis.railway.app"
      }
    }
  }
}
