# Riley AI - Git Ignore File

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
vendor/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
*.min.js
*.min.css

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.backup
*.bak
*.old

# Cache directories
.cache/
.npm/
.yarn/

# PHP specific
composer.phar
composer.lock

# Riley specific
riley_memory.json
training_data/
session_data/
user_data/

# SSL certificates (keep private)
*.pem
*.key
*.crt
*.p12

# API keys and secrets
config/secrets.php
api_keys.txt
tokens.txt

# Large media files (use Git LFS instead)
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.webm

# Compressed files
*.zip
*.rar
*.7z
*.tar.gz

# System generated files
.htaccess
.htpasswd
